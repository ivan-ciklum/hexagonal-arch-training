{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ClubDatabase": "Host=localhost;Port=5432;Database=clubexample;Username=clubuser;Password=clubpass123",
    "Redis": "localhost:6379"
  },
