{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "write-route": {
        "ClusterId": "write-cluster",
        "Match": {
          "Path": "/api/write/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/write"
          }
        ]
      },
      "read-route": {
        "ClusterId": "read-cluster",
        "Match": {
          "Path": "/api/read/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/read"
          }
        ]
      }
    },
    "Clusters": {
      "write-cluster": {
        "LoadBalancingPolicy": "WeightedRoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:08",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:02:00"
          }
        },
        "Destinations": {
          "write-stable": {
            "Address": "http://localhost:5001",
            "Metadata": {
              "Weight": "90"
            }
          },
          "write-canary": {
            "Address": "http://localhost:5003",
            "Metadata": {
              "Weight": "10"
            }
          }
        }
      },
      "read-cluster": {
        "LoadBalancingPolicy": "WeightedRoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:08",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:02:00"
          }
        },
        "Destinations": {
          "read-stable": {
            "Address": "http://localhost:4095",
            "Metadata": {
              "Weight": "90"
            }
          },
          "read-canary": {
            "Address": "http://localhost:4097",
            "Metadata": {
              "Weight": "10"
            }
          }
        }
      }
    }
  }
}
